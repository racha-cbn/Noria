      "pr_auc": 0.12462370598853406,
      "brier_calibrated": 0.07544012085070491
    },
    "validation": {
      "roc_auc": {
        "roc_auc": 0.6206568487041029,
        "ci_low": 0.6107077165152431,
        "ci_high": 0.6306824322084041,
        "n_bootstrap": 1000
      },
      "pr_auc": 0.12653782859572413,
      "brier_calibrated": 0.07538141727345736
    }
  },
  "low_reliability_age_threshold": 25,
  "low_reliability_rule": "show a stronger caution message when AGE_YEARS < low_reliability_age_threshold (display rule decided after E16; the model output is unchanged)",
